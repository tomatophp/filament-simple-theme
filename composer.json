{
    "name": "tomatophp/filament-simple-theme",
    "type": "library",
    "description": "A simple theme for FilamentPHP with custom user menu in sidebar",
    "homepage": "https://tomatophp.com/en/plugins/filament-simple-theme",
    "support": {
        "issues": "https://github.com/tomatophp/filament-simple-theme/issues",
        "source": "https://github.com/tomatophp/filament-simple-theme",
        "docs": "https://tomatophp.com/en/plugins/filament-simple-theme"
    },
    "keywords": [
        "php",
        "laravel",
        "filament",
        "filament-theme",
        "filament-theme-simple"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentSimpleTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentSimpleTheme\\Tests\\": "tests/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentSimpleTheme\\FilamentSimpleThemeServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse src --level=0 --memory-limit=2G",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "version": "5.0.0"
}
